      },
      {
        "id": "salt",
        "name": "盐",
        "amount": 1,
        "unit": "克",
        "kind": "seasoning"
      },
      {
        "id": "sugar",
        "name": "白糖",
        "amount": 2,
        "unit": "克",
        "kind": "seasoning"
      },
      {
        "id": "oil",
        "name": "食用油",
        "amount": 35,
        "unit": "毫升",
        "kind": "seasoning",
        "note": "煎鸡肉25毫升，炒香料10毫升；为用油计划，非实测吸油量"
      }
    ],
    "steps": [
      {
        "title": "切好鸡丁",
        "minutes": 5,
        "heat": "不开火",
        "uses": [
          { "id": "boneless_chicken_thigh", "amount": 400, "unit": "克" }
        ],
        "instruction": "鸡腿肉400克吸干，切约1.5厘米块；处理后洗手并清洁刀板。",
        "checkpoint": "鸡肉完全解冻，大小接近。"
      },
      {
        "title": "拌料冷藏腌肉",
        "minutes": 20,
        "heat": "不开火，冷藏",
        "uses": [
          { "id": "ginger", "amount": 5, "unit": "克" },
          { "id": "soy_sauce", "amount": 10, "unit": "毫升" },
          { "id": "cooking_wine", "amount": 10, "unit": "毫升" },
          { "id": "starch", "amount": 10, "unit": "克" },
          { "id": "salt", "amount": 1, "unit": "克" }
        ],
        "instruction": "上步鸡丁拌入姜末5克、生抽10毫升、料酒10毫升、淀粉10克和盐1克，盖好冷藏腌20分钟。",
        "checkpoint": "腌料均匀包裹，没有干粉团。"
      },
      {
        "title": "备好炒香用料",
        "minutes": 4,
        "heat": "不开火",
        "uses": [
          { "id": "dried_chili", "amount": 15, "unit": "克" },
          { "id": "sichuan_pepper", "amount": 2, "unit": "克" },
          { "id": "ginger", "amount": 5, "unit": "克" },
          { "id": "garlic", "amount": 15, "unit": "克" },
          { "id": "spring_onion", "amount": 15, "unit": "克" }
        ],
        "instruction": "干辣椒15克剪段，姜5克、蒜15克切片，小葱15克切段；花椒2克另放，全部保持干爽。",
        "checkpoint": "葱段单放，香料表面无水。"
      },
      {
        "title": "平铺煎鸡丁",
        "minutes": 11,
        "heat": "中火转中小火",
        "uses": [{ "id": "oil", "amount": 25, "unit": "毫升" }],
        "instruction": "油25毫升预热约1分钟，腌好鸡丁单层入锅；转中小火煎约10分钟，间隔翻面。",
        "checkpoint": "鸡丁表面微黄，不拥挤堆叠。"
      },
      {
        "title": "检查鸡肉熟度",
        "minutes": 2,
        "heat": "中小火",
        "uses": [],
        "instruction": "测几块较厚鸡丁的中心，达到75℃并保持至少30秒才盛出；未达到就继续加热复测。",
        "checkpoint": "中心温度合格，再移到洁净盘。"
      },
      {
        "title": "炒香辣椒花椒",
        "minutes": 2,
        "heat": "小火",
        "uses": [{ "id": "oil", "amount": 10, "unit": "毫升" }],
        "instruction": "锅中补油10毫升，放备好的姜蒜、干辣椒和花椒，小火翻动约2分钟；葱段暂不下锅。",
        "checkpoint": "闻到香味，辣椒尚未焦黑。"
      },
      {
        "title": "合炒装盘",
        "minutes": 2,
        "heat": "中小火",
        "uses": [{ "id": "sugar", "amount": 2, "unit": "克" }],
        "instruction": "熟鸡丁回锅，加白糖2克和备好的全部葱段，翻匀约2分钟后装盘；不再添盐。",
        "checkpoint": "鸡丁裹上香料，葱香散出。"
      }
    ],
    "sources": [
      {
        "title": "辣子鸡丁",
        "url": "https://china-kitchen.lkk.com.cn/zh-CN/recipe/0/1e/recipe-830",
        "author": "清炒的",
        "site": "李锦记中国官网·美食小博",
        "language": "zh",
        "accessedAt": "2026-09-10",
        "supports": "菜谱参考：腌鸡肉、先熟制鸡块，再与干辣椒花椒及葱姜蒜合炒的顺序。"
      },
      {
        "title": "烹煮及翻热",
        "url": "https://www.cfs.gov.hk/sc_chi/trade_zone/safe_kitchen/Cooking_and_reheating.html",
        "author": "香港食物安全中心",
        "site": "香港食物安全中心",
        "language": "zh",
        "accessedAt": "2026-09-10",
        "supports": "食品安全参考：食物中心75℃或以上持续至少30秒，以及最厚处测温和探针清洁。"
      }
    ],
    "adaptation": "家庭定量改编：改用去骨鸡腿肉和煎炒，省去黑胡椒及芝麻，加入生抽。份量、用油和时间均为家庭估算，未实测；口感不同于原方油炸版。个人成品中的青椒等变化不代表按本配方试做。",
    "safetyTips": [
      "鸡肉需完全解冻；盛熟食的盘子不可直接沿用盛生鸡肉的容器。",
      "计时和表面颜色不能替代中心测温，探针每次使用前后清洁消毒。",
      "生抽及料酒按实际包装核对大豆、小麦等过敏原。干辣椒和花椒主要用于增香，可挑出不吃。"
    ]
  },
  {
