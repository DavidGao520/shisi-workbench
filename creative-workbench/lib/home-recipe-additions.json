        "title": "调味合炒",
        "minutes": 2,
        "heat": "中火",
        "uses": [
          { "id": "soy_sauce", "amount": 12, "unit": "毫升" },
          { "id": "salt", "amount": 1, "unit": "克" },
          { "id": "water", "amount": 40, "unit": "毫升" }
