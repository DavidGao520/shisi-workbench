# Server-only. Never prefix these with VITE_ or NEXT_PUBLIC_.
# Set the equivalent production values in Sites environment settings.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# Optional temporary-credential token.
TENCENT_SESSION_TOKEN=
# Enable only after the Tencent ASR service and usage budget are configured.
KITCHEN_VOICE_ENABLED=0
# Global maximum paid attempts/day (UTC); default 100, maximum 1000.
KITCHEN_VOICE_DAILY_LIMIT=100
# Tencent TokenHub Guangzhou key, restricted to hy-vision-2.0-instruct.
# This is a separate API key, not the ASR SecretId/SecretKey.
TOKENHUB_API_KEY=
KITCHEN_PHOTO_ENABLED=0
KITCHEN_PHOTO_DAILY_LIMIT=100

# Optional standalone SCF voice deployment. See scf/voice-backend/README.md.
# These do not configure or deploy the existing Sites application.
VOICE_QUOTA_BUCKET=
VOICE_QUOTA_REGION=ap-guangzhou
SCF_OWNER_UIN=
SCF_ROLE_NAME=shisi-voice-scf-role
SCF_FUNCTION_NAME=shisi-voice-backend
# Separate, narrowly scoped deployment identity. Never put it into the judge ZIP.
SCF_DEPLOY_SECRET_ID=
SCF_DEPLOY_SECRET_KEY=
# Only when the deployment identity uses temporary credentials.
SCF_DEPLOY_SESSION_TOKEN=
